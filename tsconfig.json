{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@spayce/shared": [
                "packages/shared/src/index.ts"
            ],
            "@spayce/shared/*": [
                "packages/shared/src/*"
            ],
            "@spayce/core": [
                "packages/core/src/index.ts"
            ],
            "@spayce/core/*": [
                "packages/core/src/*"
            ],
            "@spayce/infrastructure": [
                "packages/infrastructure/src/index.ts"
            ],
            "@spayce/infrastructure/*": [
                "packages/infrastructure/src/*"
            ],
            "@spayce/react-ui": [
                "packages/react-ui/src/index.ts"
            ],
            "@spayce/react-ui/*": [
                "packages/react-ui/src/*"
            ],
            "@spayce/desktop/*": [
                "packages/desktop/src/*"
            ]
        }
    },
    "include": [
        "packages/*/src/**/*"
    ],
    "exclude": [
        "node_modules",
        "**/dist/**"
    ]
}