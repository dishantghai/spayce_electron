{
    "name": "@spayce/desktop",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/main.cjs",
    "scripts": {
        "dev": "concurrently \"pnpm build:main --watch\" \"vite\" \"wait-on http://localhost:5173 dist/main.cjs && electron .\"",
        "build:main": "node scripts/build-main.js",
        "dev:vite": "vite",
        "dev:electron": "electron .",
        "build": "pnpm build:main && vite build && electron-builder",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:preflight": "vitest run __tests__/preflight/",
        "test:smoke": "vitest run __tests__/smoke/",
        "test:build": "vitest run __tests__/build/",
        "test:native": "vitest run __tests__/native-modules/",
        "test:ipc": "vitest run __tests__/ipc/",
        "test:db": "vitest run __tests__/database/",
        "test:paths": "vitest run __tests__/paths/",
        "test:all": "vitest run --reporter=verbose",
        "check-health": "node scripts/check-health.js",
        "predev": "node scripts/check-health.js",
        "lint": "eslint src --ext .ts,.tsx",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@spayce/core": "workspace:*",
        "@spayce/infrastructure": "workspace:*",
        "@spayce/react-ui": "workspace:*",
        "better-sqlite3": "^11.10.0",
        "electron-store": "^8.1.0",
        "lucide-react": "^0.309.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-native-web": "^0.19.10"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^20.10.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^4.2.1",
        "concurrently": "^9.2.1",
        "electron": "30.5.1",
        "electron-builder": "^24.9.1",
        "esbuild": "^0.27.2",
        "tsx": "^4.21.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.10",
        "wait-on": "^9.0.3"
    }
}