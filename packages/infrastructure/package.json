{
    "name": "@spayce/infrastructure",
    "version": "0.1.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./persistence": {
            "import": "./dist/persistence/index.js",
            "types": "./dist/persistence/index.d.ts"
        },
        "./di": {
            "import": "./dist/di/index.js",
            "types": "./dist/di/index.d.ts"
        },
        "./services": {
            "import": "./dist/services/index.js",
            "types": "./dist/services/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "better-sqlite3": "^11.0.0"
    },
    "devDependencies": {
        "@spayce/core": "workspace:*",
        "@types/better-sqlite3": "^7.6.11",
        "typescript": "^5.4.0",
        "vitest": "^1.6.0"
    },
    "peerDependencies": {
        "@spayce/core": "workspace:*"
    }
}