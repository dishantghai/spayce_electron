{
    "name": "spayce-electron",
    "version": "0.1.0",
    "private": true,
    "description": "Personal Learning Management System with integrated browser",
    "author": "Spayce Team",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "pnpm --filter @spayce/desktop dev",
        "build": "pnpm --filter @spayce/desktop build",
        "test": "vitest --run",
        "test:watch": "vitest --watch",
        "test:core": "vitest --run packages/core/__tests__",
        "test:infra": "vitest --run packages/infrastructure/__tests__",
        "test:ui": "vitest --run packages/react-ui/__tests__",
        "test:desktop": "pnpm --filter @spayce/desktop test",
        "test:desktop:preflight": "pnpm --filter @spayce/desktop test:preflight",
        "test:desktop:smoke": "pnpm --filter @spayce/desktop test:smoke",
        "test:desktop:all": "pnpm --filter @spayce/desktop test:all",
        "test:spec": "vitest --run --reporter=verbose",
        "test:debug": "vitest --run --reporter=verbose --no-file-parallelism",
        "test:all": "pnpm test && pnpm test:desktop",
        "check-health": "pnpm --filter @spayce/desktop check-health",
        "pre-commit": "node scripts/pre-commit-checks.js",
        "lint": "eslint packages --ext .ts,.tsx",
        "format": "prettier --write \"packages/**/*.{ts,tsx,json}\"",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@esbuild/darwin-arm64": "0.21.5",
        "@rollup/rollup-darwin-arm64": "^4.55.3",
        "@types/node": "^20.10.0",
        "eslint": "^8.55.0",
        "prettier": "^3.1.0",
        "typescript": "^5.3.0",
        "vitest": "^1.1.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}